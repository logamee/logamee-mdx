{
  "path": [
    "src",
    "src-tauri/src"
  ],
  "format": [
    "typescript",
    "tsx",
    "rust"
  ],
  "ignore": [
    "**/*.test.*",
    "**/*.node-test.*",
    "**/__snapshots__/**",
    "**/*_tests.rs",
